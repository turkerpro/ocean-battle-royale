# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.boop
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/
*.code-workspace

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Photon Fusion
/[Aa]ssets/Photon/
/[Aa]ssets/PhotonRealtime/
/[Aa]ssets/PhotonVoice/
/[Aa]ssets/PhotonChat/
/[Aa]ssets/PhotonFusion/
!/[Aa]ssets/Photon/**/*.meta

# PlayFab
/[Aa]ssets/PlayFab/

# Local settings
/[Aa]ssets/_Project/Resources/PhotonAppSettings.asset
/[Aa]ssets/_Project/Resources/PlayFabSettings.asset

# Unity Package Manager - ignore downloaded packages but keep manifest/lock
/[Pp]ackages/com.unity/
/[Pp]ackages/modules/
/[Pp]ackages/manifest.json.meta

# Logs
*.log
