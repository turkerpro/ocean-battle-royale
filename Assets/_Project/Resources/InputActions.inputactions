<?xml version="1.0" encoding="utf-8"?>
<InputActionAsset name="OceanBattleInput" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <actionMaps>
    <actionMap name="Player" id="player-map">
      <action name="Move" type="Value" binding="<Gamepad>/leftStick" id="move-binding">
        <interactions>
          <interaction name="tap" />
        </interactions>
        <processors>
          <processor name="stickDeadzone" min="0.15" max="1" zero="0.8" />
        </processors>
      </action>
      <action name="Aim" type="Value" binding="<Gamepad>/rightStick" id="aim-binding">
        <processors>
          <processor name="stickDeadzone" min="0.15" max="1" zero="0.8" />
        </processors>
      </action>
      <action name="Fire" type="Button" binding="<Gamepad>/rightTrigger" id="fire-binding" />
      <action name="DeployMine" type="Button" binding="<Gamepad>/leftTrigger" id="mine-binding" />
      <action name="WeaponSwitch" type="Button" binding="<Gamepad>/dpadRight" id="weapon-switch-binding" />
      <action name="MoveKeyboard" type="Value" binding="<Keyboard>/wasd" id="move-kb-binding">
        <processors>
          <processor name="normalize" />
        </processors>
      </action>
      <action name="AimMouse" type="Value" binding="<Mouse>/position" id="aim-mouse-binding">
        <processors>
          <processor name="normalize" />
        </processors>
      </action>
      <action name="FireMouse" type="Button" binding="<Mouse>/leftButton" id="fire-mouse-binding" />
      <action name="MineKeyboard" type="Button" binding="<Keyboard>/space" id="mine-kb-binding" />
      <action name="WeaponSwitchKeyboard" type="Button" binding="<Keyboard>/tab" id="weapon-switch-kb-binding" />
    </actionMap>
  </actionMaps>
  <controlSchemes>
    <controlScheme name="Gamepad" bindingGroup="Gamepad" />
    <controlScheme name="Keyboard&Mouse" bindingGroup="KeyboardMouse" />
    <controlScheme name="Touch" bindingGroup="Touch" />
  </controlSchemes>
</InputActionAsset>
